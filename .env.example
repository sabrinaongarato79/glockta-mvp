PORT=3000

# URL pública del sitio ya hosteado (sin barra al final). Necesaria para que
# Mercado Pago sepa a dónde redirigir al comprador y enviar el webhook.
# Ej.: https://glockta.onrender.com — en localhost dejala vacía.
PUBLIC_BASE_URL=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (https://www.mercadopago.com.ar/developers/panel/app)
# Con las credenciales de PRUEBA (sandbox) ya se puede hacer el flujo de cobro
# completo. Cuando quieras cobrar de verdad, reemplazalas por las de PRODUCCIÓN.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Número de WhatsApp de contacto en formato internacional sin signos ni espacios.
# Ej.: 5491122334455 (54 = Argentina, 9 + código de área sin 0, número sin 15)
WHATSAPP_NUMBER=
CONTACT_EMAIL=

# Panel de administración (/admin.html): segundo rol de usuario ("empresa/admin"),
# distinto del candidato que navega el sitio público. Elegí cualquier clave larga.
# Sin este valor, el panel queda accesible en modo demo (útil solo en localhost).
ADMIN_TOKEN=

# Asistente de IA (Claude, https://console.anthropic.com) — opcional.
# Habilita: 1) completar el Career Passport a partir de un relato libre,
# 2) explicaciones del Glockta Match redactadas con tono de mentor.
# Sin esta clave, ambas funciones quedan ocultas y el resto del sitio sigue igual.
ANTHROPIC_API_KEY=

# Jooble REST API - request key at https://jooble.org/api/about
JOOBLE_API_KEY=

# Optional Adzuna provider (only use if target country is supported)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Provider used by default: jooble | adzuna | demo
JOB_PROVIDER=demo
